# Copy to .env. All variables are prefixed SHER_.
SHER_BASE_URL=https://sher-5x0c.onrender.com
SHER_ID_LENGTH=6
SHER_MAX_FILE_BYTES=10485760
SHER_MAX_TEXT_BYTES=102400
SHER_RATE_LIMIT_UPLOAD_PER_MIN=20
SHER_RATE_LIMIT_VIEW_PER_MIN=60
SHER_CLEANUP_INTERVAL_SECONDS=30
SHER_LOG_LEVEL=INFO
SHER_ENABLE_DOCS=false
# Local (non-Docker) runs:
# SHER_REDIS_URL=redis://localhost:6379/0
# SHER_STORAGE_DIR=./storage
